# Server port (optional, defaults to 3500)
PORT=3500

# Comma-separated tracking parameters to look for in the final URL
# If any of these appear as query params, the trace stops immediately (success)
TRACKING_PARAMS=btag,stag,cxd,mid,affid

# Max redirect hops per attempt
MAX_HOPS=20

# Max retry attempts if tracking params not found
MAX_RETRIES=3

# Delay between retries in milliseconds
RETRY_DELAY_MS=1000

# Request timeout in milliseconds
TIMEOUT_MS=10000

# ScrapingBee fallback (used when requests are blocked by 403/429/503)
# Get your key at https://app.scrapingbee.com
SCRAPINGBEE_API_KEY=
ENABLE_JS_FALLBACK=false
